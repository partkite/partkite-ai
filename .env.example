SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_ANON_KEY=<anon-key>

# Gemini API key (comma-separated for key rotation)
GEMINI_API_KEY=<gemini-api-key>

# Direct Postgres DSN — use transaction pooler (port 6543)
# Get from: Supabase dashboard > Project Settings > Database > Connection string
POSTGRES_DSN=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Model overrides (optional)
GEMINI_CHAT_MODEL=gemma-3-27b-it
GEMINI_EMBED_MODEL=gemini-embedding-001

# API authentication — comma-separated keys clients must send as X-API-Key header
# Leave unset to disable auth (dev only)
API_KEYS=your-secret-key-1,your-secret-key-2

# Logging level: DEBUG for verbose, INFO for production
LOG_LEVEL=INFO
